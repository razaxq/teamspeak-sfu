# Hostname resolving directly to this server's public IPv4, or the IPv4 itself.
SFU_PUBLIC_HOST=sfu.example.com
# Read the TeamSpeak server license, then change this to accept.
TSSERVER_LICENSE_ACCEPTED=
SFU_VOICE_PORT=19987
SFU_QUERY_PORT=11022
SFU_WS_PORT=18344
SFU_MEDIA_PORT=19125
SFU_CONTAINER_NAME=ts6-sfu-selfhost
SFU_DATA_VOLUME=ts6-sfu-selfhost-data
SFU_STATE_DIR=/var/lib/ts6-sfu-selfhost
# 0 preserves TeamSpeak's own slot setting. Its license still applies.
# Upgrades from the old forced-eight-slot preview migrate 8 to 32 once.
SFU_TS_MAXCLIENTS=0
# Fixed ARM64 image; do not replace with latest.
SFU_SERVER_IMAGE=docker.io/teamspeaksystems/teamspeak6-server@sha256:a89b53db7b4a213251a47b652b212d1314728ec8c498f5246cf7e7622587ed89
